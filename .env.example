# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird nicht committet. Schritte zum Einrichten: siehe README, Abschnitt "Supabase einrichten".

# --- Supabase (Region Frankfurt) -------------------------------------------------------------
# Project Settings -> API. Beide Werte sind öffentlich gedacht: Der Schutz der Daten kommt von
# Row Level Security in der Datenbank. Den geheimen service_role / secret key NICHT eintragen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Claude API (nur auf dem Server benutzt) -----------------------------------------------
ANTHROPIC_API_KEY=

# Beispielmodus (optional): "beispiel" liefert feste Beispiel-Antworten statt eines echten
# KI-Aufrufs, "echt" erzwingt den echten Aufruf. Ohne Angabe gilt: Mit "npm run dev" und
# ohne API-Schlüssel ist der Beispielmodus automatisch an, im Produktions-Build nie.
# KI_MODUS=beispiel
